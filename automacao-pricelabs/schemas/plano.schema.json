{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:automacao-pricelabs:plano:1",
  "title": "Plano de ações de uma execução",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "modo",
    "acoes",
    "bloqueios"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9T:_-]{1,40}$"
    },
    "modo": {
      "enum": [
        "observar",
        "ativo",
        "contencao",
        "parado"
      ]
    },
    "acoes": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tipo",
          "listing",
          "data",
          "motivo",
          "origem"
        ],
        "properties": {
          "tipo": {
            "enum": [
              "criar",
              "apagar",
              "faria_criar",
              "sombra"
            ]
          },
          "listing": {
            "type": "string",
            "pattern": "^[0-9]+___[0-9]+$"
          },
          "data": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "price",
              "price_type",
              "reason"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "price": {
                "enum": [
                  "-5",
                  "-7",
                  "-10",
                  "0"
                ]
              },
              "price_type": {
                "const": "percent"
              },
              "reason": {
                "type": "string",
                "pattern": "^auto-jev [A-Za-z0-9T:_-]{1,40}$"
              }
            }
          },
          "motivo": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "origem": {
            "enum": [
              "jev",
              "regra"
            ]
          },
          "confianca": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "tipo": {
                  "const": "criar"
                }
              }
            },
            "then": {
              "required": [
                "payload",
                "confianca"
              ],
              "properties": {
                "origem": {
                  "const": "jev"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "tipo": {
                  "const": "apagar"
                }
              }
            },
            "then": {
              "properties": {
                "origem": {
                  "const": "regra"
                }
              }
            }
          }
        ]
      }
    },
    "bloqueios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alvo",
          "regra"
        ],
        "properties": {
          "alvo": {
            "type": "string",
            "maxLength": 80
          },
          "regra": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}
