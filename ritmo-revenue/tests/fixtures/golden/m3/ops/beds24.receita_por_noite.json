    "departure": "2026-11-22",
    "status": "confirmed",
    "channel": "booking",
    "referer": "Booking.com",
    "price": null
   },
   "expected": {
    "chegada": "2026-11-20",
    "noites": 2,
    "total": 0.0
   }
  }
 ]
}
